@model TaxiFleetManager.Models.TaxiRoute

@{
    ViewData["Title"] = "Route Details";
    var trips = Model.Trips ?? new List<TaxiFleetManager.Models.Trip>();
    var distinctVehicles = trips.Select(t => t.VehicleId).Distinct().Count();
    var totalRevenue = trips.Sum(t => t.AmountCollected);
}

<h2 class="page-title">Route Details</h2>

<div class="row align-items-center mb-4">
    <div class="col-md-3">
        <img src="~/images/routes.png" alt="Routes" style="height: 150px; object-fit: contain;" />
    </div>
    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-body">
                <p class="mb-1" style="font-size: 1.1rem; color: #f5a623; font-weight: 600;">@Model.Name</p>
                <p class="mb-0" style="color: #aaaaaa;">@Model.StartPoint → @Model.EndPoint — full performance breakdown for this route below.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">Route Information</div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4 text-warning">Route Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4 text-warning">Start Point</dt>
                    <dd class="col-sm-8">@Model.StartPoint</dd>

                    <dt class="col-sm-4 text-warning">End Point</dt>
                    <dd class="col-sm-8">@Model.EndPoint</dd>

                    <dt class="col-sm-4 text-warning">Standard Fare</dt>
                    <dd class="col-sm-8">R @Model.StandardFare.ToString("N2")</dd>

                    <dt class="col-sm-4 text-warning">Route Type</dt>
                    <dd class="col-sm-8">@Model.RouteType</dd>

                    <dt class="col-sm-4 text-warning">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge-active">Active</span>
                        }
                        else
                        {
                            <span class="badge-inactive">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="row">
            <div class="col-6">
                <div class="stat-card">
                    <div class="stat-value">@trips.Count</div>
                    <div class="stat-label">Total Trips</div>
                </div>
            </div>
            <div class="col-6">
                <div class="stat-card">
                    <div class="stat-value">@distinctVehicles</div>
                    <div class="stat-label">Vehicles Used</div>
                </div>
            </div>
            <div class="col-12">
                <div class="stat-card">
                    <div class="stat-value">R @totalRevenue.ToString("N2")</div>
                    <div class="stat-label">Total Revenue Generated</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (trips.Any())
{
    <div class="card mb-4">
        <div class="card-header">Trip History on This Route</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Vehicle</th>
                            <th>Driver</th>
                            <th>Passengers</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trip in trips.OrderByDescending(t => t.TripDate).Take(20))
                        {
                            <tr>
                                <td>@trip.TripDate.ToString("dd MMM yyyy")</td>
                                <td>@trip.Vehicle?.RegistrationNumber</td>
                                <td>@trip.Driver?.FullName</td>
                                <td>@trip.PassengerCount</td>
                                <td>R @trip.AmountCollected.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model?.RouteId" class="btn btn-primary">Edit Route</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>