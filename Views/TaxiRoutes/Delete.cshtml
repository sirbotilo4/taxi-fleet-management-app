@model TaxiFleetManager.Models.TaxiRoute

@{
    ViewData["Title"] = "Delete Route";
}

<h2 class="page-title">Delete Route</h2>

<div class="row align-items-center mb-4">
    <div class="col-md-3">
        <img src="~/images/routes.png" alt="Routes" style="height: 150px; object-fit: contain;" />
    </div>
    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-body">
                <p class="mb-1" style="font-size: 1.1rem; color: #e74c3c; font-weight: 600;">This action cannot be undone.</p>
                <p class="mb-0" style="color: #aaaaaa;">You are about to permanently remove this route. If any trips have been logged against it, deletion may fail — consider marking it inactive instead to preserve historical data.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header" style="border-bottom: 2px solid #c0392b; color: #e74c3c;">
                ⚠️ Are you sure you want to delete this route?
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4 text-warning">Route Name</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                    <dt class="col-sm-4 text-warning">Start Point</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.StartPoint)</dd>

                    <dt class="col-sm-4 text-warning">End Point</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.EndPoint)</dd>

                    <dt class="col-sm-4 text-warning">Standard Fare</dt>
                    <dd class="col-sm-8">R @Model.StandardFare.ToString("N2")</dd>

                    <dt class="col-sm-4 text-warning">Route Type</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.RouteType)</dd>

                    <dt class="col-sm-4 text-warning">Status</dt>
                    <dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd>
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="RouteId" />
                    <div class="d-flex gap-2">
                        <input type="submit" value="Yes, Delete" class="btn btn-danger" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>