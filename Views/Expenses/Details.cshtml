@model TaxiFleetManager.Models.Expense

@{
    ViewData["Title"] = "Expense Details";
}

<h2 class="page-title">Expense Details</h2>

<div class="row align-items-center mb-4">
    <div class="col-md-3">
        <img src="~/images/expenses.png" alt="Expenses" style="height: 150px; object-fit: contain;" />
    </div>
    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-body">
                <p class="mb-1" style="font-size: 1.1rem; color: #f5a623; font-weight: 600;">Expense Record</p>
                <p class="mb-0" style="color: #aaaaaa;">Full details for this expense entry. Use the actions below to edit or remove it from the system.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">Expense Information</div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4 text-warning">Vehicle</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Vehicle.RegistrationNumber)</dd>

                    <dt class="col-sm-4 text-warning">Expense Type</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.ExpenseType)</dd>

                    <dt class="col-sm-4 text-warning">Amount</dt>
                    <dd class="col-sm-8">R @Model.Amount.ToString("N2")</dd>

                    <dt class="col-sm-4 text-warning">Date</dt>
                    <dd class="col-sm-8">@Model.ExpenseDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4 text-warning">Description</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Description) ? "No description provided" : Model.Description)
                    </dd>
                </dl>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.ExpenseId" class="btn btn-primary">Edit Expense</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>