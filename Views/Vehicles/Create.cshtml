@model TaxiFleetManager.Models.Vehicle

@{
    ViewData["Title"] = "Add Vehicle";
}

<h2 class="page-title">Add New Vehicle</h2>

<div class="row align-items-center mb-4">
    <div class="col-md-3">
        <img src="~/images/vehicles.png" alt="Vehicles" style="height: 150px; object-fit: contain;" />
    </div>
    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-body">
                <p class="mb-1" style="font-size: 1.1rem; color: #f5a623; font-weight: 600;">Every vehicle added is a new stream of revenue.</p>
                <p class="mb-0" style="color: #aaaaaa;">Register a new taxi to your fleet below. Assign a driver now, or leave it unassigned and set that up later from the Vehicles list.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Vehicle Information</div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="RegistrationNumber" class="form-label">Registration Number</label>
                        <input asp-for="RegistrationNumber" class="form-control" placeholder="e.g. CA 123-456" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Make" class="form-label">Make</label>
                        <input asp-for="Make" class="form-control" placeholder="e.g. Toyota" />
                        <span asp-validation-for="Make" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Model" class="form-label">Model</label>
                        <input asp-for="Model" class="form-control" placeholder="e.g. Quantum" />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Capacity" class="form-label">Passenger Capacity</label>
                        <input asp-for="Capacity" class="form-control" placeholder="e.g. 15" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="In Maintenance">In Maintenance</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DriverId" class="form-label">Assign Driver (optional)</label>
                        <select asp-for="DriverId" class="form-select" asp-items="ViewBag.DriverId">
                            <option value="">-- Unassigned --</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <input type="submit" value="Save Vehicle" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}