@model TaxiFleetManager.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h2 class="page-title">Delete Vehicle</h2>

<div class="row align-items-center mb-4">
    <div class="col-md-3">
        <img src="~/images/vehicles.png" alt="Vehicles" style="height: 150px; object-fit: contain;" />
    </div>
    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-body">
                <p class="mb-1" style="font-size: 1.1rem; color: #e74c3c; font-weight: 600;">This action cannot be undone.</p>
                <p class="mb-0" style="color: #aaaaaa;">You are about to permanently remove this vehicle. All trip and expense history linked to it will be deleted as well — consider marking it "Inactive" instead if you want to preserve records.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header" style="border-bottom: 2px solid #c0392b; color: #e74c3c;">
                ⚠️ Are you sure you want to delete this vehicle?
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4 text-warning">Registration Number</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.RegistrationNumber)</dd>

                    <dt class="col-sm-4 text-warning">Make</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Make)</dd>

                    <dt class="col-sm-4 text-warning">Model</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Model)</dd>

                    <dt class="col-sm-4 text-warning">Capacity</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Capacity)</dd>

                    <dt class="col-sm-4 text-warning">Status</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>

                    <dt class="col-sm-4 text-warning">Assigned Driver</dt>
                    <dd class="col-sm-8">@(Model.Driver != null ? Model.Driver.FullName : "Unassigned")</dd>
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="VehicleId" />
                    <div class="d-flex gap-2">
                        <input type="submit" value="Yes, Delete" class="btn btn-danger" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>