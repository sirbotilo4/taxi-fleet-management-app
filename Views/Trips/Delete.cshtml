@model TaxiFleetManager.Models.Trip

@{
    ViewData["Title"] = "Delete Trip";
}

<h2 class="page-title">Delete Trip</h2>

<div class="row align-items-center mb-4">
    <div class="col-md-3">
        <img src="~/images/trips.png" alt="Trips" style="height: 150px; object-fit: contain;" />
    </div>
    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-body">
                <p class="mb-1" style="font-size: 1.1rem; color: #e74c3c; font-weight: 600;">This action cannot be undone.</p>
                <p class="mb-0" style="color: #aaaaaa;">You are about to permanently remove this trip record. This will affect revenue totals for the driver, vehicle, and route involved.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header" style="border-bottom: 2px solid #c0392b; color: #e74c3c;">
                 Are you sure you want to delete this trip?
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4 text-warning">Date</dt>
                    <dd class="col-sm-8">@Model.TripDate.ToString("dd MMM yyyy, HH:mm")</dd>

                    <dt class="col-sm-4 text-warning">Driver</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Driver.FullName)</dd>

                    <dt class="col-sm-4 text-warning">Vehicle</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Vehicle.RegistrationNumber)</dd>

                    <dt class="col-sm-4 text-warning">Route</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Route.Name)</dd>

                    <dt class="col-sm-4 text-warning">Passengers</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.PassengerCount)</dd>

                    <dt class="col-sm-4 text-warning">Amount</dt>
                    <dd class="col-sm-8">R @Model.AmountCollected.ToString("N2")</dd>

                    <dt class="col-sm-4 text-warning">Payment Method</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.PaymentMethod)</dd>

                    @if (!string.IsNullOrEmpty(Model.PaymentReference))
                    {
                        <dt class="col-sm-4 text-warning">Payment Reference</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.PaymentReference)</dd>
                    }
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="TripId" />
                    <div class="d-flex gap-2">
                        <input type="submit" value="Yes, Delete" class="btn btn-danger" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>