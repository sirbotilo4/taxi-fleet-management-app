@model TaxiFleetManager.Models.Driver

@{
    ViewData["Title"] = "Delete Driver";
}

<h2 class="page-title">Delete Driver</h2>

<div class="row align-items-center mb-4">
    <div class="col-md-3">
        <img src="~/images/driver.png" alt="Driver" style="height: 150px; object-fit: contain;" />
    </div>
    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-body">
                <p class="mb-1" style="font-size: 1.1rem; color: #e74c3c; font-weight: 600;">This action cannot be undone.</p>
                <p class="mb-0" style="color: #aaaaaa;">You are about to permanently remove this driver from the system. Their trip history will remain intact, but they will no longer be assignable to any vehicle.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header" style="border-bottom: 2px solid #c0392b; color: #e74c3c;">
                ⚠️ Are you sure you want to delete this driver?
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4 text-warning">Full Name</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.FullName)</dd>

                    <dt class="col-sm-4 text-warning">Contact Number</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.ContactNumber)</dd>

                    <dt class="col-sm-4 text-warning">License Number</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.LicenseNumber)</dd>

                    <dt class="col-sm-4 text-warning">Hire Date</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.HireDate)</dd>

                    <dt class="col-sm-4 text-warning">Status</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="DriverId" />
                    <div class="d-flex gap-2">
                        <input type="submit" value="Yes, Delete" class="btn btn-danger" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>