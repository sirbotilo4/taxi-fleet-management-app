@model TaxiFleetManager.Models.Driver

@{
    ViewData["Title"] = "Add Driver";
}

<h2 class="page-title">Add New Driver</h2>

<div class="row align-items-center mb-4">
    <div class="col-md-3">
        <img src="~/images/driver.png" alt="Driver" style="height: 150px; object-fit: contain;" />
    </div>
    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-body">
                <p class="mb-1" style="font-size: 1.1rem; color: #f5a623; font-weight: 600;">Every great fleet starts with great drivers.</p>
                <p class="mb-0" style="color: #aaaaaa;">Fill in the driver's details below and assign them a secure PIN. They'll use it to log trips and track their own performance — keeping things accountable on both ends.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Driver Information</div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Themba Botilo" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContactNumber" class="form-label">Contact Number</label>
                        <input asp-for="ContactNumber" class="form-control" placeholder="e.g. 0731234567" />
                        <span asp-validation-for="ContactNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LicenseNumber" class="form-label">License Number</label>
                        <input asp-for="LicenseNumber" class="form-control" placeholder="e.g. DL123456" />
                        <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Pin" class="form-label">Driver PIN (4 digits)</label>
                        <input asp-for="Pin" class="form-control" maxlength="4" placeholder="e.g. 1234" />
                        <small style="color: #aaaaaa;">Driver uses this PIN to access their dashboard</small>
                        <span asp-validation-for="Pin" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <input type="submit" value="Save Driver" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}